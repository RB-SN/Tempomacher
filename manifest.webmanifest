{
  "name": "Tempomacher – Lauf-Coach",
  "short_name": "Tempomacher",
  "description": "Persönlicher Lauf-Coach mit adaptivem Trainingsplan bis 100 km.",
  "lang": "de-CH",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F2F5F4",
  "theme_color": "#0E4F54",
  "categories": [
    "sports",
    "health",
    "fitness"
  ],
  "icons": [
    {
      "src": "icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            ".fit",
            ".gpx",
            ".tcx",
            ".zip",
            "application/octet-stream",
            "application/gpx+xml",
            "application/vnd.garmin.tcx+xml",
            "application/zip"
          ]
        }
      ]
    }
  }
}